__pycache__/
*.py[cod]
*$py.class
.venv/
upilotserver~/.venv/

# Logs & runtime artifacts
/log/
*.log
temp_*.cs
*.tmp

# Reports & build artifacts
/Reports/
/artifacts/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 根目录临时目录
.tmp/
.tmp-release-check/

